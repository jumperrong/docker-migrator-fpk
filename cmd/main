#!/bin/bash
# Docker 迁移工具 — 容器生命周期脚本
#
# 飞牛 Docker 应用：appcenter 会自动根据 config/resource 的 docker-project 声明
# 执行 docker compose up/down，故 start/stop 只返回成功即可。
# status 通过 docker inspect 探测容器状态。

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"
CONTAINER="dockermigrator"

case "$1" in
  start)
    # do nothing, docker application will be started by appcenter
    exit 0
    ;;
  stop)
    # do nothing, docker application will be stopped by appcenter
    exit 0
    ;;
  status)
    st="$(docker inspect --format '{{.State.Status}}' "$CONTAINER" 2>/dev/null || true)"
    [ "$st" = "running" ] && exit 0
    exit 3
    ;;
  *)
    exit 1
    ;;
esac
